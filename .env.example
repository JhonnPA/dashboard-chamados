# Copie este arquivo para ".env" e preencha com os valores reais.
# O .env fica fora do controle de versão (.gitignore).

# Caminho do JSON da conta de serviço do Google
GOOGLE_CREDENTIALS_FILE=credentials.json

# Nome exato da planilha no Google Drive (como aparece na aba do navegador)
SPREADSHEET_NAME=

# ID da pasta do Google Drive onde o dashboard.html é atualizado
# (trecho da URL depois de "/folders/")
DRIVE_FOLDER_ID=

# PythonAnywhere (deixe em branco para desativar o envio)
PYTHONANYWHERE_USERNAME=
PYTHONANYWHERE_API_TOKEN=
PYTHONANYWHERE_CAMINHO_REMOTO=/home/SEU_USUARIO/dashboard.html

# --- Usado apenas no PythonAnywhere, pelo portal_flask_app.py ---
DASHBOARD_USUARIO=
DASHBOARD_SENHA=
